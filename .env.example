# Slack OAuth — from your Slack app at api.slack.com/apps
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Random 32+ char string. Used by Bolt to sign the OAuth state cookie.
SLACK_STATE_SECRET=

# HTTP mode port (Railway/Fly inject PORT)
PORT=3000

# Postgres — Supabase, Railway, Fly Postgres, or local
DATABASE_URL=postgresql://user:password@localhost:5432/hunch

# Optional: separate DB for the multi-tenancy test suite
TEST_DATABASE_URL=

# Optional: Sentry DSN. If unset, errors only log to stderr.
SENTRY_DSN=

# Optional: log level
LOG_LEVEL=info
