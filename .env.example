# Slack credentials — from your Slack app at api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # required only for Socket Mode (local dev)

# Set to "true" to use Socket Mode locally; leave unset/false for HTTP mode in prod
SLACK_SOCKET_MODE=true

# HTTP mode port (Railway/Fly inject PORT)
PORT=3000

# Postgres — Supabase, Railway, Fly Postgres, or local
DATABASE_URL=postgresql://user:password@localhost:5432/hunch

# Optional: log level
LOG_LEVEL=info
